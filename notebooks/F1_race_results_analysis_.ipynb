from pyspark.sql import SparkSession
from pyspark.sql import functions as F
from pyspark.sql.window import Window

spark = (
    SparkSession.builder
    .appName("F1_Big_Data_Analysis")
    .getOrCreate()
)

spark.sparkContext.setLogLevel("ERROR")

print("Spark version:", spark.version)
print("Spark session initialized successfully!")
import pandas as pd
from google.colab import files

uploaded = files.upload()

file_path = "/content/race_results.csv"

print("File uploaded successfully!")
df = spark.read.csv(
    file_path,
    header=True,
    inferSchema=True
)

print("Number of rows:", df.count())
print("Number of columns:", len(df.columns))

print("\nColumn names:")
print(df.columns)

print("\nSchema:")
df.printSchema()

print("\nFirst 10 records:")
df.show(10, truncate=False)
print("Dataset dimensions:", df.count(), "rows x", len(df.columns), "columns")

print("\nMissing values per column:")
df.select([
    F.sum(
        F.col(c).isNull().cast("int")
    ).alias(c)
    for c in df.columns
]).show(truncate=False)

print("\nDuplicate race IDs:")
df.groupBy("race_id") \
  .count() \
  .filter(F.col("count") > 1) \
  .show()

print("\nSeason range:")
df.select(
    F.min("season").alias("first_season"),
    F.max("season").alias("last_season")
).show()

print("\nSprint indicator values:")
df.groupBy("is_sprint_weekend") \
  .count() \
  .orderBy("is_sprint_weekend") \
  .show()
df_clean = df.dropDuplicates()

text_columns = [
    "race_id", "grand_prix", "circuit",
    "country_iso3", "region", "pole_position",
    "winner", "podium_p2", "podium_p3",
    "fastest_lap_driver"
]

for c in text_columns:
    df_clean = df_clean.withColumn(
        c, F.trim(F.col(c))
    )

df_clean = (
    df_clean
    .withColumn("season", F.col("season").cast("int"))
    .withColumn("round_number", F.col("round_number").cast("int"))
    .withColumn(
        "race_date",
        F.to_date("race_date", "yyyy-MM-dd")
    )
    .withColumn(
        "safety_car_periods",
        F.col("safety_car_periods").cast("int")
    )
    .withColumn(
        "is_sprint_weekend",
        F.col("is_sprint_weekend").cast("int")
    )
)

print("Cleaned dataset:")
df_clean.printSchema()

df_clean.show(5, truncate=False)
df_clean.createOrReplaceTempView("f1_races")

print("Temporary SQL view created: f1_races")

spark.sql("""
    SELECT
        COUNT(*) AS total_races,
        COUNT(DISTINCT season) AS total_seasons,
        COUNT(DISTINCT circuit) AS unique_circuits,
        COUNT(DISTINCT winner) AS unique_winners
    FROM f1_races
""").show()
driver_wins = (
    df_clean
    .filter(F.col("winner").isNotNull())
    .groupBy("winner")
    .agg(
        F.count("*").alias("race_wins"),
        F.countDistinct("season").alias("seasons_with_wins")
    )
    .orderBy(F.desc("race_wins"), F.asc("winner"))
)

print("Top 10 drivers by wins:")
driver_wins.show(10, truncate=False)
podium_data = (
    df_clean
    .select(
        "race_id",
        "season",
        F.explode(
            F.array(
                F.col("winner"),
                F.col("podium_p2"),
                F.col("podium_p3")
            )
        ).alias("driver")
    )
    .filter(
        F.col("driver").isNotNull() &
        (F.col("driver") != "")
    )
)

podium_stats = (
    podium_data
    .groupBy("driver")
    .agg(
        F.count("*").alias("podium_finishes"),
        F.countDistinct("season").alias("seasons_on_podium")
    )
    .orderBy(F.desc("podium_finishes"))
)

podium_stats.show(10, truncate=False)
pole_stats = (
    df_clean
    .filter(F.col("pole_position").isNotNull())
    .groupBy("pole_position")
    .agg(
        F.count("*").alias("pole_positions")
    )
    .orderBy(F.desc("pole_positions"))
)

pole_stats.show(10, truncate=False)
pole_conversion = (
    df_clean
    .filter(
        F.col("pole_position").isNotNull() &
        F.col("winner").isNotNull()
    )
    .groupBy("pole_position")
    .agg(
        F.count("*").alias("pole_starts"),
        F.sum(
            F.when(
                F.col("pole_position") == F.col("winner"), 1
            ).otherwise(0)
        ).alias("wins_from_pole")
    )
    .withColumn(
        "conversion_rate_pct",
        F.round(
            100 * F.col("wins_from_pole") / F.col("pole_starts"),
            2
        )
    )
    .orderBy(F.desc("conversion_rate_pct"))
)

pole_conversion.show(10, truncate=False)
season_stats = (
    df_clean
    .groupBy("season")
    .agg(
        F.count("*").alias("total_races"),
        F.avg("safety_car_periods").alias("avg_safety_cars"),
        F.sum("safety_car_periods").alias("total_safety_cars"),
        F.sum("is_sprint_weekend").alias("sprint_weekends")
    )
    .orderBy("season")
)

season_stats.show(30, truncate=False)
region_stats = (
    df_clean
    .groupBy("region")
    .agg(
        F.count("*").alias("total_races"),
        F.avg("safety_car_periods").alias("avg_safety_cars"),
        F.sum("safety_car_periods").alias("total_safety_cars")
    )
    .orderBy(F.desc("avg_safety_cars"))
)

region_stats.show(truncate=False)
sprint_stats = (
    df_clean
    .groupBy("is_sprint_weekend")
    .agg(
        F.count("*").alias("total_races"),
        F.avg("safety_car_periods").alias("avg_safety_cars"),
        F.avg(
            F.when(
                F.col("pole_position") == F.col("winner"), 1.0
            ).otherwise(0.0)
        ).alias("pole_to_win_rate")
    )
    .withColumn(
        "pole_to_win_rate_pct",
        F.round(F.col("pole_to_win_rate") * 100, 2)
    )
    .orderBy("is_sprint_weekend")
)

sprint_stats.show(truncate=False)
import matplotlib.pyplot as plt

wins_pd = driver_wins.limit(10).toPandas()
wins_pd = wins_pd.sort_values("race_wins")

plt.figure(figsize=(10, 6))
plt.barh(wins_pd["winner"], wins_pd["race_wins"])
plt.xlabel("Number of race wins")
plt.ylabel("Driver")
plt.title("Top 10 Formula 1 Drivers by Race Wins")
plt.tight_layout()
plt.show()
season_wins = (
    df_clean
    .groupBy("season")
    .agg(F.count("*").alias("total_races"))
    .orderBy("season")
    .toPandas()
)

plt.figure(figsize=(12, 5))
plt.plot(
    season_wins["season"],
    season_wins["total_races"],
    marker="o"
)
plt.xlabel("Season")
plt.ylabel("Recorded races")
plt.title("Number of Recorded Races per F1 Season")
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()
parquet_path = "/content/f1_races_parquet"

df_clean.write \
    .mode("overwrite") \
    .parquet(parquet_path)

parquet_df = spark.read.parquet(parquet_path)

print("CSV and Parquet row counts:")
print("CSV source:", df_clean.count())
print("Parquet:", parquet_df.count())

parquet_df.show(5, truncate=False)
import time

csv_path = "/content/race_results.csv"

def benchmark_csv():
    data = (
        spark.read
        .option("header", True)
        .schema(df_clean.schema)
        .csv(csv_path)
    )

    return (
        data.groupBy("season")
        .agg(F.avg("safety_car_periods").alias("avg_sc"))
        .count()
    )

def benchmark_parquet():
    data = spark.read.parquet(parquet_path)

    return (
        data.groupBy("season")
        .agg(F.avg("safety_car_periods").alias("avg_sc"))
        .count()
    )

# Warm up Spark and the execution environment
benchmark_csv()
benchmark_parquet()

csv_times = []
parquet_times = []

for _ in range(3):
    start = time.perf_counter()
    benchmark_csv()
    csv_times.append(time.perf_counter() - start)

    start = time.perf_counter()
    benchmark_parquet()
    parquet_times.append(time.perf_counter() - start)

print("CSV trial times:", csv_times)
print("Parquet trial times:", parquet_times)
print("Average CSV time:", round(sum(csv_times) / len(csv_times), 4), "seconds")
print("Average Parquet time:", round(sum(parquet_times) / len(parquet_times), 4), "seconds")
print("Invalid or missing parsed dates:")
df_clean.filter(F.col("race_date").isNull()).show()

print("Records where race date year differs from season:")
df_clean.filter(
    F.year("race_date") != F.col("season")
).select(
    "race_id", "season", "race_date", "grand_prix", "winner"
).show(20, truncate=False)

print("Duplicate race identifiers:")
df_clean.groupBy("race_id").count() \
    .filter(F.col("count") > 1) \
    .show()

print("Race counts by season:")
df_clean.groupBy("season") \
    .count() \
    .orderBy("season") \
    .show(30)
